# =============================================================================
#  Caddy Log Interface  —  configuration
#  Copy to `.env` and edit.  Never commit `.env`.
# =============================================================================

# ----- Core ------------------------------------------------------------------
# Image to run. The default follows every 1.x release; pin an exact version
# (e.g. victimofareload/caddylogs:1.0.0) to upgrade only when you choose.
# APP_IMAGE=victimofareload/caddylogs:1
TZ=UTC
# Port published on the host. The UI + API are served from this single port.
APP_PORT=8899
# Interface to publish on. 0.0.0.0 = all interfaces (as configured).
# Use 127.0.0.1 if you want only a local reverse proxy to reach it.
BIND_ADDRESS=0.0.0.0
LOG_LEVEL=info

# ----- Storage (all bind mounts, no named volumes) ---------------------------
# Where the SQLite database is kept ON THE HOST. Must be on a local filesystem:
# SQLite's WAL mode is not safe over NFS/CIFS.
# This directory must be writable by PUID:PGID below --- see README section 2.
DATA_PATH=./data
# UID:GID the containers run as. Bind mounts keep the host's ownership, so this
# has to match whoever owns DATA_PATH, CADDY_CONF_PATH and CADDY_RUN_PATH:
#   sudo chown -R 1000:1000 ./data ./caddy/conf ./caddy/run
# The ID does not need to exist as a host account. Do not use 0 (root).
PUID=1000
PGID=1000

# ----- Caddy (the server itself) -------------------------------------------
# Image to run. Swap in a custom xcaddy build if you need plugins, such as a
# DNS provider for the DNS-01 challenge.
CADDY_IMAGE=caddy:2
# Directory ON THE HOST containing the Caddyfile. Caddy reads it; the web
# container writes it when you apply a change, so it must be owned by
# PUID:PGID. The directory is mounted (not the file) so saves are atomic.
CADDY_CONF_PATH=./caddy/conf
# Caddy's certificates / private keys, and its autosaved config. Caddy only;
# never mounted into the log interface.
CADDY_DATA_PATH=./caddy/data
CADDY_STATE_PATH=./caddy/config
# Holds Caddy's admin API socket, shared with the app container. Create it
# owned by PUID:PGID with mode 0700: the directory is the access control.
CADDY_RUN_PATH=./caddy/run

# ----- Caddy configuration pages --------------------------------------------
# Master switch for editing Caddy's configuration from the interface.
#   true  (default) the Caddy menu, pages and configuration API are available.
#   false the Caddy menu disappears from the interface entirely and the
#         configuration API refuses every request. Caddy itself keeps running
#         from its Caddyfile; only managing it from here is switched off.
# Restart the app container after changing it: docker compose up -d app
CADDY_MANAGE=true
# Usernames (from AUTH_USERS) allowed to change the configuration. Empty means
# every signed-in user. Everyone else can still view it.
CADDY_EDITORS=
# How many past versions of the Caddyfile to keep for restore.
CADDY_HISTORY_KEEP=100
# Longest to wait for Caddy to validate or load a config (certificate
# provisioning happens in the background and does not count).
CADDY_ADMIN_TIMEOUT_MS=15000

# ----- Caddy log source ------------------------------------------------------
# Path ON THE HOST to the directory holding Caddy's JSON access logs. Caddy
# writes here; it is bind-mounted read-only into the app containers at /logs.
# Caddy creates log files mode 0600 by default, which the app (running as
# PUID) cannot read: set `mode 0644` in the log output — see Caddyfile.example.
CADDY_LOG_HOST_PATH=./caddy/logs
# Glob (relative to /logs) of files to tail. Rotated files matching this are
# also picked up so nothing is lost across a rotation.
CADDY_LOG_GLOB=*.log
# Comma-separated hostnames to ignore entirely (never stored).
IGNORE_HOSTS=
# Comma-separated CIDRs whose requests are ignored (e.g. internal healthchecks).
IGNORE_CIDRS=

# ----- Authentication --------------------------------------------------------
# REQUIRED: users allowed to log in. Format:  user:password[,user2:password2]
# Passwords may be plaintext (hashed with scrypt at startup, never stored raw)
# or a pre-computed hash of the form  scrypt$<saltHex>$<hashHex>
# Generate a hash without exposing the password in .env:
#   docker compose run --rm --no-deps app node src/tools/hash.js
AUTH_USERS=admin:change-me-immediately

# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Idle timeout in minutes (session dies if unused this long). 0 disables.
SESSION_IDLE_MINUTES=120
# "Keep me signed in" on the sign-in page: such a session is exempt from the
# idle timeout and lasts this many days. 0 removes the option.
SESSION_REMEMBER_DAYS=30
# Set true when running behind a reverse proxy that sets X-Forwarded-For.
# When true, ONLY requests from TRUSTED_PROXIES have that header honoured.
TRUST_PROXY=true
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Marks the session cookie `Secure`. Browsers DISCARD Secure cookies on plain
# http:// origins, so with this true you must reach the UI over HTTPS - normally
# by proxying it through Caddy. Sign-in refuses with a clear message rather than
# looping if the two disagree.
# Set false ONLY if you are accessing it directly over plain HTTP on a trusted
# network; credentials then cross the wire unencrypted.
COOKIE_SECURE=true
# Failed logins allowed per IP per window before lockout.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
# Global API request rate limit, per IP per minute.
API_RATE_LIMIT=600

# ----- Retention -------------------------------------------------------------
# How long aggregated statistics are kept (daily granularity). This is the
# number that governs long-term history; it survives log rotation.
RETENTION_DAYS=365
# How long HOURLY granularity is kept before being folded into daily rows.
HOURLY_RETENTION_DAYS=45
# How long individual request rows (with the raw JSON line) are kept. These
# power the live log stream and per-request drill-downs. Keep this modest.
RAW_RETENTION_HOURS=48
# Hard ceiling on individual request rows, oldest evicted first. Safety valve
# so a traffic spike cannot fill the disk.
RAW_MAX_ROWS=5000000
# High-cardinality dimensions (URLs, IPs, user agents) are trimmed to the top N
# values per hour once the bucket is older than DIM_COMPACT_AFTER_DAYS; the
# remainder is folded into a single "(other)" row so totals stay correct.
DIM_TOP_N=250
DIM_COMPACT_AFTER_DAYS=7

# ----- IP enrichment: notoolkit.com (BGP prefix + ASN + registrant detail) ----
# ON BY DEFAULT. What it does: for each PUBLIC visitor IP address in your logs,
# the app asks the free notoolkit.com API which network it belongs to (BGP
# prefix, AS number, network name, registry, WHOIS). That powers the "network"
# columns, the ASN tables and the per-address pages.
#
# What leaves your server: the visitor IP address (once per address, then
# cached locally for ENRICH_TTL_DAYS) and AS numbers. Nothing else — no URLs,
# user agents, hostnames or other log content. Private, loopback and
# link-local addresses (10/8, 172.16/12, 192.168/16, 100.64/10, 127/8,
# 169.254/16, ::1, fc00::/7, fe80::/10) are never sent.
#
# To turn it off, set NOTOOLKIT_ENABLED=false: the app then makes NO calls to
# notoolkit.com at all and runs fully offline (it makes no other outbound
# connections). You lose BGP prefix, AS name/org, RIR and WHOIS detail.
# Visitor country still comes from MaxMind, and ASN number + organisation
# still resolve locally if GeoLite2-ASN.mmdb is present in MAXMIND_HOST_PATH.
# Data already cached from notoolkit is kept.
NOTOOLKIT_ENABLED=true
# Lookups are query parameters on the root: /?ip=<addr> and /?asn=<number>
NOTOOLKIT_API_URL=https://notoolkit.com/
# If this stack runs on the same server that hosts notoolkit.com, the container
# usually CANNOT reach the public address: it exits via the default route and
# the firewall will not hairpin it back in from the Docker subnet. Point at the
# origin on the LAN instead and name the virtual host explicitly, so the request
# never leaves the local network:
#   NOTOOLKIT_API_URL=http://10.0.0.5/
#   NOTOOLKIT_HOST_HEADER=notoolkit.com
# Verify either way with:
#   docker compose run --rm --no-deps app node src/tools/probe.js
NOTOOLKIT_HOST_HEADER=
# The public API requires no authentication. Leave blank. If a key is ever
# required, set it here and it is sent as: Authorization: Bearer <key>
NOTOOLKIT_API_KEY=
NOTOOLKIT_AUTH_HEADER=Authorization
NOTOOLKIT_AUTH_SCHEME=Bearer
# Requests per second ceiling against the notoolkit API.
NOTOOLKIT_RATE_PER_SEC=10
NOTOOLKIT_TIMEOUT_MS=4000
NOTOOLKIT_CONCURRENCY=4
NOTOOLKIT_MAX_RETRIES=5
# Re-resolve a cached IP after this many days.
ENRICH_TTL_DAYS=30
# Re-fetch per-ASN registry detail (RIR, WHOIS, prefix counts) after this many
# days. This is one lookup per distinct ASN, so it can be generous.
ENRICH_ASN_TTL_DAYS=90
# Max time ingest will wait on enrichment before writing rows as pending.
ENRICH_INLINE_TIMEOUT_MS=2000

# ----- IP enrichment: MaxMind GeoLite2 (country) -----------------------------
MAXMIND_ENABLED=true
# Path ON THE HOST to a directory containing GeoLite2-Country.mmdb
# (and optionally GeoLite2-City.mmdb / GeoLite2-ASN.mmdb).
# Mounted read-only at /geoip. See README for how to obtain these.
MAXMIND_HOST_PATH=./geoip
MAXMIND_COUNTRY_DB=/geoip/GeoLite2-Country.mmdb
MAXMIND_ASN_DB=/geoip/GeoLite2-ASN.mmdb

# ----- Ingest tuning ---------------------------------------------------------
INGEST_BATCH_SIZE=2000
INGEST_FLUSH_MS=1000
# Events are aggregated into rollups only after this lag, giving async
# enrichment a chance to land before the row is counted.
ROLLUP_LAG_MS=15000

# ----- Live log stream -------------------------------------------------------
STREAM_POLL_MS=400
STREAM_MAX_EVENTS_PER_TICK=300

# ----- First run -------------------------------------------------------------
# On first start, read existing log files from the beginning to backfill
# history. Set false to only record requests from now on.
INGEST_BACKFILL=true
# When backfilling, skip files whose last-modified time is older than this many
# days. 0 = no limit.
INGEST_BACKFILL_MAX_DAYS=0
