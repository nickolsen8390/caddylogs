{
  "id": "/",
  "name": "Caddy Log Interface",
  "short_name": "Caddy Logs",
  "description": "Traffic, requests and configuration for your Caddy server.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Requests", "short_name": "Requests", "description": "Live requests and search", "url": "/requests", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Traffic", "short_name": "Traffic", "description": "Visitors, page views and campaigns", "url": "/traffic", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Clients", "short_name": "Clients", "description": "Every source address", "url": "/clients", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
