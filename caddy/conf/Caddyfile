# Caddyfile for the combined Caddy + Caddy Log Interface stack.
#
# Managed from the interface (Caddy pages): edits there are validated by
# Caddy, applied with a graceful reload, and written back here.
#
# Do not add an `admin` global option. docker-compose.yml puts the admin API
# on a unix socket (CADDY_ADMIN), which is how the interface reloads Caddy.

# JSON access logs for the log interface. Every site that should appear in
# the statistics imports this.
(logging) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
			# Caddy creates log files 0600 (root only) by default; the log
			# interface runs as PUID and needs to read them.
			mode 0644
		}
		format json
	}
}

# The log interface itself. Deliberately not logged: its own polling and live
# stream would dominate the statistics.
stats.example.com {
	@notlocal not remote_ip 10.30.1.0/24 10.0.0.0/24
	handle @notlocal {
		respond 403
	}

	handle {
		reverse_proxy 127.0.0.1:8899 {
			# Server-sent events must not be buffered, or the live log
			# stream stalls.
			flush_interval -1
		}
	}
}
